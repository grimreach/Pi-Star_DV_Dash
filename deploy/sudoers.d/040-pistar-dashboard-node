# Narrowly-scoped sudo permissions for the Node.js Pi-Star dashboard,
# which runs as the `pi-star` user via systemd (see README's deployment
# section). Mirrors the pattern the original PHP dashboard's own sudoers
# rules use for www-data (see PISTAR_DASH_MOUNT / PISTAR_DASH_INSTALL /
# PISTAR_DASH_SYSTEMCTL in the stock Pi-Star sudoers), scoped down to just
# what this app currently needs: writing /etc/mmdvmhost, restarting
# MMDVMHost, WiFi scanning, WiFi connect/disconnect via add_network/
# set_network/enable_network/disable_network/remove_network/save_config,
# power (reboot/shutdown), and modem calibration (pistar-calibration-start).
# Does not grant broad root access, and deliberately excludes ifdown/ifup
# and wpa_cli reconfigure/select_network — select_network in particular
# would disable every other configured network profile, which could break
# a working connection if a new one fails (see wifiConnect.ts).
#
# Install: copy this file to /etc/sudoers.d/040-pistar-dashboard-node,
# then `sudo chmod 440` it and `sudo visudo -c` to validate syntax before
# trusting it. Requires the root filesystem to be writable (`rpi-rw`).
#
# Paths below (/usr/bin/mount, /usr/bin/install, /usr/bin/systemctl,
# /sbin/wpa_cli) were verified against a real Pi-Star device (mount/
# install/systemctl via `which`; wpa_cli/reboot/shutdown match the stock
# Pi-Star sudoers rules for www-data) — confirm they match yours before
# installing; adjust if not (sudoers matches the literal string invoked,
# so it must match exactly what the corresponding server/src/pistar/*.ts
# file passes to execFile). /bin/sync is assumed at its standard path —
# verify with `which sync` if the power action fails.

Defaults!PISTAR_DASH_NODE_ALL !requiretty

Cmnd_Alias PISTAR_DASH_NODE_MOUNT = \
    /usr/bin/mount -o remount\,rw /, \
    /usr/bin/mount -o remount\,ro /

Cmnd_Alias PISTAR_DASH_NODE_INSTALL = \
    /usr/bin/install -m 644 -o root -g root /tmp/pistar-node-cw-*.mmdvmhost /etc/mmdvmhost

Cmnd_Alias PISTAR_DASH_NODE_SYSTEMCTL = \
    /usr/bin/systemctl restart mmdvmhost.service

Cmnd_Alias PISTAR_DASH_NODE_WIFI = \
    /sbin/wpa_cli -i wlan0 scan, \
    /sbin/wpa_cli -i wlan0 scan_results, \
    /sbin/wpa_cli -i wlan0 status, \
    /sbin/wpa_cli -i wlan0 add_network, \
    /sbin/wpa_cli -i wlan0 set_network *, \
    /sbin/wpa_cli -i wlan0 enable_network *, \
    /sbin/wpa_cli -i wlan0 disable_network *, \
    /sbin/wpa_cli -i wlan0 remove_network *, \
    /sbin/wpa_cli -i wlan0 save_config

Cmnd_Alias PISTAR_DASH_NODE_POWER = \
    /bin/sync, \
    /sbin/reboot, \
    /sbin/shutdown -h now

Cmnd_Alias PISTAR_DASH_NODE_CALIBRATION = \
    /usr/local/sbin/pistar-calibration-start, \
    /usr/local/sbin/pistar-calibration-start stop

Cmnd_Alias PISTAR_DASH_NODE_ALL = \
    PISTAR_DASH_NODE_MOUNT, PISTAR_DASH_NODE_INSTALL, PISTAR_DASH_NODE_SYSTEMCTL, PISTAR_DASH_NODE_WIFI, \
    PISTAR_DASH_NODE_POWER, PISTAR_DASH_NODE_CALIBRATION

pi-star ALL=(root) NOPASSWD: PISTAR_DASH_NODE_ALL
